# ==============================================================================
# Database (PostgreSQL + pgvector)
# ==============================================================================
# Hai URL (xem docs/db/README.md, mục "Ba vai trò DB"):
# - DATABASE_URL: runtime, BẮT BUỘC là role basement_app (bị RLS lọc). Superuser sẽ bỏ qua RLS.
#   Role được tạo trong migration, chưa có mật khẩu. Sau khi migrate, chạy một lần:
#     ALTER ROLE basement_app PASSWORD '<BASEMENT_APP_PASSWORD>';
# - DIRECT_URL: chỉ cho prisma migrate / db pull, dùng owner hoặc superuser.
# Khi chạy ngoài Docker (local machine kết nối qua port map):
DATABASE_URL="postgresql://basement_app:basement_app_local@localhost:5432/basement_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/basement_db?schema=public"

# Khi chạy trong Docker container (kết nối nội bộ mạng docker qua hostname postgres):
# DATABASE_URL="postgresql://basement_app:basement_app_local@postgres:5432/basement_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@postgres:5432/basement_db?schema=public"

BASEMENT_APP_PASSWORD=basement_app_local

# Tổ chức mặc định (uuid trong bảng organizations), dùng tạm cho đến khi có xác thực.
DEFAULT_ORGANIZATION_ID=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basement_db
POSTGRES_PORT=5432

# ==============================================================================
# Redis Cache & Queue
# ==============================================================================
# Khi chạy ngoài Docker:
REDIS_URL="redis://localhost:6379"

# Khi chạy trong Docker container:
# REDIS_URL="redis://redis:6379"

REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# Backend API Service
# ==============================================================================
PORT=3001
API_PORT=3001
API_URL="http://localhost:3001"

# ==============================================================================
# Frontend Web Service
# ==============================================================================
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"
