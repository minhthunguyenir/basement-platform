# Mẫu biến môi trường cho apps/web. Chép thành apps/web/.env.local rồi điền.
# Chỉ biến có tiền tố NEXT_PUBLIC_; giá trị được gắn cứng vào mã gửi cho trình duyệt lúc build (không đặt bí mật ở đây).

# Địa chỉ API. Để trống thì dùng http://localhost:3001.
# Staging (Vercel): https://basement-platform.onrender.com  (đổi trên Vercel phải deploy lại mới có hiệu lực)
NEXT_PUBLIC_API_URL=
