# ==============================================================================
# Database (PostgreSQL + pgvector)
# ==============================================================================
# Khi chạy ngoài Docker (local machine kết nối qua port map):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/basement_db?schema=public"

# Khi chạy trong Docker container (kết nối nội bộ mạng docker qua hostname postgres):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/basement_db?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basement_db
POSTGRES_PORT=5432

# ==============================================================================
# Redis Cache & Queue
# ==============================================================================
# Khi chạy ngoài Docker:
REDIS_URL="redis://localhost:6379"

# Khi chạy trong Docker container:
# REDIS_URL="redis://redis:6379"

REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# Backend API Service
# ==============================================================================
PORT=3001
API_PORT=3001
API_URL="http://localhost:3001"

# ==============================================================================
# Frontend Web Service
# ==============================================================================
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"
