model announcements {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String                @db.Uuid
  branch_id          String?               @db.Uuid
  audience           announcement_audience
  title              String                @db.VarChar(200)
  body               String
  publish_at         DateTime              @default(now()) @db.Timestamptz(6)
  expires_at         DateTime?             @db.Timestamptz(6)
  is_pinned          Boolean               @default(false)
  created_by         String                @db.Uuid
  created_at         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at         DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?             @db.Timestamptz(6)
  announcement_reads announcement_reads[]
  branches           branches?             @relation(fields: [branch_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcements_branch_id")
  users              users                 @relation(fields: [created_by, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcements_created_by")
  organizations      organizations         @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_announcements_organization_id")

  @@unique([id, organization_id], map: "uq_announcements_id_org")
}

